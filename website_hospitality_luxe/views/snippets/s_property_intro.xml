<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_property_intro" name="About and Property Introduction">
    <section class="s_property_intro py-5 bg-white" data-snippet="s_property_intro" data-name="About and Property Introduction">
        <div class="container py-4">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="position-relative">
                        <img src="/website_hospitality_luxe/static/src/img/content/resort_exterior.jpg" alt="Grand Luxury Palace Resort" class="img-fluid rounded-3 shadow-lg w-100" style="height: 480px; object-fit: cover;"/>
                        <div class="position-absolute bottom-0 start-0 m-4 p-3 rounded-2 text-white shadow" style="background: rgba(23, 42, 40, 0.92); border-left: 3px solid #C5A46D; max-width: 260px;">
                            <div class="h5 fw-bold mb-1" style="color: #C5A46D;">Est. 1928</div>
                            <div class="small text-light">A Century of Unrivaled Bespoke Hospitality</div>
                        </div>
                    </div>
                </div>
