<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_location_contact" name="Location &amp; Arrival Details">
    <section class="s_location_contact py-5" style="background-color: #FFFFFF;" data-snippet="s_location_contact" data-name="Location &amp; Arrival Details">
        <div class="container py-4">
            <div class="text-center mb-5">
                <span class="luxe-badge-gold mb-2">Private Peninsula</span>
                <h2 class="display-5 fw-bold mb-3" style="color: #172A28; font-family: var(--lux-font-heading);">
                    Arrival &amp; Sanctuary Location
                </h2>
                <div class="luxe-divider"></div>
                <p class="text-muted lead mx-auto" style="max-width: 650px;">
                    Situated on an untouched private peninsula secluded from the world, yet effortlessly accessible via yacht and helicopter.
                </p>
            </div>
            <div class="row g-4 align-items-center">
                <div class="col-lg-6">
                    <div class="p-4 p-md-5 rounded-3 border shadow-sm" style="background-color: #FAF7F2; border-color: rgba(197, 164, 109, 0.25) !important;">
                        <h3 class="h4 fw-bold mb-4" style="color: #172A28; font-family: var(--lux-font-heading);">Bespoke Journey Coordination</h3>
                        <div class="d-flex mb-4">
                            <div class="me-3 fs-4" style="color: #C5A46D;"><i class="fa fa-map-marker"></i></div>
                            <div>
                                <h4 class="h6 fw-bold mb-1 text-dark">Geographic Coordinates</h4>
                                <p class="text-muted small mb-0">Marina Sanctuary Peninsula, 04° 10' 32" N, 73° 30' 44" E</p>
                            </div>
                        </div>
                        <div class="d-flex mb-4">
                            <div class="me-3 fs-4" style="color: #C5A46D;"><i class="fa fa-plane"></i></div>
                            <div>
                                <h4 class="h6 fw-bold mb-1 text-dark">International Access</h4>
                                <p class="text-muted small mb-0">25 minutes via resort private catamaran or 10 minutes via helicopter transfer.</p>
                            </div>
                        </div>
                        <div class="d-flex mb-4">
                            <div class="me-3 fs-4" style="color: #C5A46D;"><i class="fa fa-phone"></i></div>
                            <div>
                                <h4 class="h6 fw-bold mb-1 text-dark">24/7 Concierge Hotline</h4>
                                <p class="text-muted small mb-0">+1 (800) 892-LUXE • concierge@resortluxe.com</p>
                            </div>
                        </div>
                        <div class="pt-2">
                            <a href="/contactus" class="btn btn-luxe-gold">Plan Arrival Transfer</a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="rounded-3 overflow-hidden border shadow-sm" style="border-color: rgba(197, 164, 109, 0.3) !important;">
                        <img src="/website_hospitality_luxe/static/src/img/content/concierge_lounge.jpg" alt="Grand Resort Concierge Hall" class="w-100 h-100" style="min-height: 380px; object-fit: cover;"/>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
