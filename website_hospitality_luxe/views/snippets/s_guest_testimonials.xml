<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_guest_testimonials" name="Guest Accolades &amp; Reviews">
    <section class="s_guest_testimonials py-5" style="background-color: #FAF7F2;" data-snippet="s_guest_testimonials" data-name="Guest Accolades &amp; Reviews">
        <div class="container py-4">
            <div class="text-center mb-5">
                <span class="luxe-badge-gold mb-2">Guest Accolades</span>
                <h2 class="display-5 fw-bold mb-3" style="color: #172A28; font-family: var(--lux-font-heading);">
                    Voices of Distinction
                </h2>
                <div class="luxe-divider"></div>
                <p class="text-muted lead mx-auto" style="max-width: 650px;">
                    Read reflections from guests who experienced the tranquility and warmth of our hospitality.
                </p>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="p-4 bg-white rounded-3 border h-100 d-flex flex-column shadow-sm">
                        <div class="mb-3" style="color: #C5A46D; font-size: 0.95rem;">
