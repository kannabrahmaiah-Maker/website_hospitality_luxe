<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Homepage Enrichment -->
    <template id="luxe_homepage" inherit_id="website.homepage" name="Hospital Care Homepage" priority="30">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <t t-call="website_hospitality_luxe.s_hospital_hero"/>
                <t t-call="website_hospitality_luxe.s_appointment_bar"/>
                <t t-call="website_hospitality_luxe.s_emergency_callout"/>
                <t t-call="website_hospitality_luxe.s_departments_grid"/>
                <t t-call="website_hospitality_luxe.s_featured_doctors"/>
                <t t-call="website_hospitality_luxe.s_hospital_stats"/>
                <t t-call="website_hospitality_luxe.s_services_facilities"/>
                <t t-call="website_hospitality_luxe.s_health_packages"/>
                <t t-call="website_hospitality_luxe.s_patient_testimonials"/>
                <t t-call="website_hospitality_luxe.s_accreditation_badges"/>
                <t t-call="website_hospitality_luxe.s_virtual_tour"/>
                <t t-call="website_hospitality_luxe.s_insurance_partners"/>
                <t t-call="website_hospitality_luxe.s_patient_faq"/>
                <t t-call="website_hospitality_luxe.s_hospital_location"/>
                <t t-call="website_hospitality_luxe.s_appointment_cta"/>
            </div>
        </xpath>
    </template>

    <!-- 2. Doctors & Specialists Directory Page -->
    <template id="doctors" name="Find Doctors &amp; Specialists - Hospital Care">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Page Hero -->
                <section class="py-5 text-white text-center position-relative" style="background-color: #073B52; min-height: 320px; display: flex; align-items: center;">
                    <img src="/website_hospitality_luxe/static/src/img/content/doctor_consultation.jpg" alt="Specialist Doctors" class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover; filter: brightness(0.35);"/>
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(7,59,82,0.85) 0%, rgba(11,79,108,0.7) 100%);"></div>
                    <div class="container py-4 position-relative" style="z-index: 2;">
                        <span class="med-badge-cyan mb-3 text-white" style="background-color: rgba(0,168,150,0.3); border-color: #00A896;">Expert Clinical Faculty</span>
                        <h1 class="display-4 fw-bold mb-3 text-white">Find a Doctor &amp; Medical Specialists</h1>
                        <div class="med-divider"></div>
                        <p class="lead mx-auto text-light" style="max-width: 700px;">Meet our board-certified medical professors, senior surgeons, and compassionate healthcare specialists.</p>
                    </div>
                </section>

                <!-- Doctors Detailed Directory Section -->
                <section class="py-5" style="background-color: #F4F9F9;">
                    <div class="container py-3">
                        <div class="row g-4 mb-4">
                            <!-- Doctor 1: Cardiology -->
                            <div class="col-md-6 col-lg-4">
                                <div class="med-doctor-card h-100 bg-white rounded-3 shadow-sm overflow-hidden d-flex flex-column">
                                    <div class="position-relative" style="height: 280px; overflow: hidden;">
                                        <img src="/website_hospitality_luxe/static/src/img/content/doctor_srinivas.jpg" alt="Dr. K. Srinivas Rao" class="w-100 h-100" style="object-fit: cover;"/>
                                        <span class="badge position-absolute top-0 end-0 m-3 text-white px-3 py-2" style="background: #0B4F6C; font-size: 0.78rem;">Cardiology</span>
                                    </div>
                                    <div class="p-4 d-flex flex-column flex-grow-1">
                                        <h4 class="h5 fw-bold mb-1" style="color: #0B4F6C;">Dr. K. Srinivas Rao</h4>
                                        <p class="text-info fw-semibold small mb-2">MBBS, MD (Gen Med), DM (Cardiology)</p>
                                        <p class="small text-muted mb-3" style="line-height: 1.6;">Chief Interventional Cardiologist with 22+ years experience in complex angioplasty, TAVR, and coronary stenting.</p>
                                        <div class="small text-muted mb-3 p-2 rounded" style="background-color: #F8FAFC; border-left: 3px solid #00A896;">
                                            <div><strong>OPD Schedule:</strong> Mon - Fri (09:00 - 14:00)</div>
                                            <div><strong>Room:</strong> OPD Block A, Room 204</div>
                                        </div>
                                        <div class="mt-auto">
                                            <a href="#appointment_bar" class="btn btn-sm btn-med-cyan w-100">
                                                <i class="fa fa-calendar-check-o me-1"></i> Book Consultation
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Doctor 2: Pediatrics -->
                            <div class="col-md-6 col-lg-4">
                                <div class="med-doctor-card h-100 bg-white rounded-3 shadow-sm overflow-hidden d-flex flex-column">
                                    <div class="position-relative" style="height: 280px; overflow: hidden;">
                                        <img src="/website_hospitality_luxe/static/src/img/content/doctor_usha.jpg" alt="Dr. Usha Nandhini" class="w-100 h-100" style="object-fit: cover;"/>
                                        <span class="badge position-absolute top-0 end-0 m-3 text-white px-3 py-2" style="background: #00A896; font-size: 0.78rem;">Pediatrics &amp; NICU</span>
                                    </div>
                                    <div class="p-4 d-flex flex-column flex-grow-1">
                                        <h4 class="h5 fw-bold mb-1" style="color: #0B4F6C;">Dr. Usha Nandhini</h4>
                                        <p class="text-info fw-semibold small mb-2">MBBS, MD (Pediatrics), DNB, FIAP</p>
                                        <p class="small text-muted mb-3" style="line-height: 1.6;">Senior Consultant Pediatrician &amp; Neonatal Care specialist with 16+ years of clinical excellence in child healthcare.</p>
                                        <div class="small text-muted mb-3 p-2 rounded" style="background-color: #F8FAFC; border-left: 3px solid #00A896;">
                                            <div><strong>OPD Schedule:</strong> Mon - Sat (10:00 - 15:00)</div>
                                            <div><strong>Room:</strong> Mother &amp; Child Wing, Room 108</div>
                                        </div>
                                        <div class="mt-auto">
                                            <a href="#appointment_bar" class="btn btn-sm btn-med-cyan w-100">
                                                <i class="fa fa-calendar-check-o me-1"></i> Book Consultation
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Doctor 3: Orthopedics -->
                            <div class="col-md-6 col-lg-4">
                                <div class="med-doctor-card h-100 bg-white rounded-3 shadow-sm overflow-hidden d-flex flex-column">
                                    <div class="position-relative" style="height: 280px; overflow: hidden;">
                                        <img src="/website_hospitality_luxe/static/src/img/content/doctor_ganesh_gowda.jpg" alt="Dr. Ganesh Gowda" class="w-100 h-100" style="object-fit: cover;"/>
                                        <span class="badge position-absolute top-0 end-0 m-3 text-white px-3 py-2" style="background: #0B4F6C; font-size: 0.78rem;">Orthopedics</span>
                                    </div>
                                    <div class="p-4 d-flex flex-column flex-grow-1">
                                        <h4 class="h5 fw-bold mb-1" style="color: #0B4F6C;">Dr. Ganesh Gowda</h4>
                                        <p class="text-info fw-semibold small mb-2">MBBS, MS (Ortho), MCh (Joint Replacements)</p>
                                        <p class="small text-muted mb-3" style="line-height: 1.6;">Chief Orthopedic &amp; Robotic Knee/Hip Replacement Surgeon with 18+ years of minimally invasive surgery mastery.</p>
                                        <div class="small text-muted mb-3 p-2 rounded" style="background-color: #F8FAFC; border-left: 3px solid #00A896;">
                                            <div><strong>OPD Schedule:</strong> Mon, Wed, Fri (11:00 - 16:00)</div>
                                            <div><strong>Room:</strong> Joint &amp; Spine Wing, Room 312</div>
                                        </div>
                                        <div class="mt-auto">
                                            <a href="#appointment_bar" class="btn btn-sm btn-med-cyan w-100">
                                                <i class="fa fa-calendar-check-o me-1"></i> Book Consultation
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Doctor 4: Neurology -->
                            <div class="col-md-6 col-lg-4">
                                <div class="med-doctor-card h-100 bg-white rounded-3 shadow-sm overflow-hidden d-flex flex-column">
                                    <div class="position-relative" style="height: 280px; overflow: hidden; background: #E2E8F0;">
                                        <img src="/website_hospitality_luxe/static/src/img/content/doctor_consultation.jpg" alt="Dr. Rajesh Varma" class="w-100 h-100" style="object-fit: cover; object-position: top;"/>
                                        <span class="badge position-absolute top-0 end-0 m-3 text-white px-3 py-2" style="background: #073B52; font-size: 0.78rem;">Neurosciences</span>
                                    </div>
                                    <div class="p-4 d-flex flex-column flex-grow-1">
                                        <h4 class="h5 fw-bold mb-1" style="color: #0B4F6C;">Dr. Rajesh Varma</h4>
                                        <p class="text-info fw-semibold small mb-2">MBBS, MD, DM (Neurology), Stroke Fellowship</p>
                                        <p class="small text-muted mb-3" style="line-height: 1.6;">Senior Neurologist specializing in acute stroke thrombolysis, epilepsy management, Parkinson's disease, and neuropathy.</p>
                                        <div class="small text-muted mb-3 p-2 rounded" style="background-color: #F8FAFC; border-left: 3px solid #00A896;">
                                            <div><strong>OPD Schedule:</strong> Tue, Thu, Sat (09:30 - 13:30)</div>
                                            <div><strong>Room:</strong> Neuro Sciences Clinic, Room 405</div>
                                        </div>
                                        <div class="mt-auto">
                                            <a href="#appointment_bar" class="btn btn-sm btn-med-cyan w-100">
                                                <i class="fa fa-calendar-check-o me-1"></i> Book Consultation
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Doctor 5: Robotic General & GI Surgery -->
                            <div class="col-md-6 col-lg-4">
                                <div class="med-doctor-card h-100 bg-white rounded-3 shadow-sm overflow-hidden d-flex flex-column">
                                    <div class="position-relative" style="height: 280px; overflow: hidden;">
                                        <img src="/website_hospitality_luxe/static/src/img/content/advanced_surgery.jpg" alt="Dr. Priya Sen" class="w-100 h-100" style="object-fit: cover;"/>
                                        <span class="badge position-absolute top-0 end-0 m-3 text-white px-3 py-2" style="background: #00A896; font-size: 0.78rem;">Robotic Surgery</span>
                                    </div>
                                    <div class="p-4 d-flex flex-column flex-grow-1">
                                        <h4 class="h5 fw-bold mb-1" style="color: #0B4F6C;">Dr. Priya Sen</h4>
                                        <p class="text-info fw-semibold small mb-2">MBBS, MS (Surg), FMAS, Da Vinci Fellow</p>
                                        <p class="small text-muted mb-3" style="line-height: 1.6;">Consultant Laparoscopic and Da Vinci Robotic Surgeon with extensive experience in hernia, bariatric, and GI interventions.</p>
                                        <div class="small text-muted mb-3 p-2 rounded" style="background-color: #F8FAFC; border-left: 3px solid #00A896;">
                                            <div><strong>OPD Schedule:</strong> Daily Mon - Sat (12:00 - 16:00)</div>
                                            <div><strong>Room:</strong> Surgical Suites Wing, Room 218</div>
                                        </div>
                                        <div class="mt-auto">
                                            <a href="#appointment_bar" class="btn btn-sm btn-med-cyan w-100">
                                                <i class="fa fa-calendar-check-o me-1"></i> Book Consultation
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Doctor 6: Emergency Trauma & Critical Care -->
                            <div class="col-md-6 col-lg-4">
                                <div class="med-doctor-card h-100 bg-white rounded-3 shadow-sm overflow-hidden d-flex flex-column">
                                    <div class="position-relative" style="height: 280px; overflow: hidden;">
                                        <img src="/website_hospitality_luxe/static/src/img/content/emergency_care.jpg" alt="Dr. Arun K. Patel" class="w-100 h-100" style="object-fit: cover;"/>
                                        <span class="badge position-absolute top-0 end-0 m-3 text-white px-3 py-2" style="background: #E63946; font-size: 0.78rem;">Emergency &amp; Trauma</span>
                                    </div>
                                    <div class="p-4 d-flex flex-column flex-grow-1">
                                        <h4 class="h5 fw-bold mb-1" style="color: #0B4F6C;">Dr. Arun K. Patel</h4>
                                        <p class="text-info fw-semibold small mb-2">MD (Emergency Medicine), FCCP, EDIC</p>
                                        <p class="small text-muted mb-3" style="line-height: 1.6;">Head of Emergency Medicine &amp; Level-1 Trauma Centre. Specializes in cardiac arrest revival, polytrauma, and ICU stabilization.</p>
                                        <div class="small text-muted mb-3 p-2 rounded" style="background-color: #F8FAFC; border-left: 3px solid #E63946;">
                                            <div><strong>Duty Schedule:</strong> 24/7 Level-1 Trauma On-Call</div>
                                            <div><strong>Unit:</strong> Emergency Entrance, Ground Floor</div>
                                        </div>
                                        <div class="mt-auto">
                                            <a href="tel:+18009112273" class="btn btn-sm btn-outline-danger w-100 fw-bold">
                                                <i class="fa fa-ambulance me-1"></i> Emergency Hotline (24/7)
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <t t-call="website_hospitality_luxe.s_appointment_bar"/>
                <t t-call="website_hospitality_luxe.s_patient_faq"/>
                <t t-call="website_hospitality_luxe.s_appointment_cta"/>
            </div>
        </t>
    </template>

    <!-- 3. Medical Departments & Centres of Excellence Page -->
    <template id="departments" name="Clinical Departments - Hospital Care">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Page Hero -->
                <section class="py-5 text-white text-center position-relative" style="background-color: #073B52; min-height: 320px; display: flex; align-items: center;">
                    <img src="/website_hospitality_luxe/static/src/img/content/advanced_surgery.jpg" alt="Centres of Excellence" class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover; filter: brightness(0.35);"/>
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(7,59,82,0.85) 0%, rgba(11,79,108,0.7) 100%);"></div>
                    <div class="container py-4 position-relative" style="z-index: 2;">
                        <span class="med-badge-cyan mb-3 text-white" style="background-color: rgba(0,168,150,0.3); border-color: #00A896;">Specialized Care Units</span>
                        <h1 class="display-4 fw-bold mb-3 text-white">Centres of Clinical Excellence</h1>
                        <div class="med-divider"></div>
                        <p class="lead mx-auto text-light" style="max-width: 700px;">Multidisciplinary super-specialty departments equipped with cutting-edge medical technology and dedicated intensive care units.</p>
                    </div>
                </section>

                <t t-call="website_hospitality_luxe.s_departments_grid"/>
                <t t-call="website_hospitality_luxe.s_services_facilities"/>
                <t t-call="website_hospitality_luxe.s_accreditation_badges"/>
                <t t-call="website_hospitality_luxe.s_appointment_bar"/>
                <t t-call="website_hospitality_luxe.s_appointment_cta"/>
            </div>
        </t>
    </template>

    <!-- 4. Hospital Facilities & Infrastructure Page -->
    <template id="facilities" name="Hospital Facilities - Hospital Care">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Page Hero -->
                <section class="py-5 text-white text-center position-relative" style="background-color: #073B52; min-height: 320px; display: flex; align-items: center;">
                    <img src="/website_hospitality_luxe/static/src/img/content/hospital_hero.jpg" alt="Hospital Infrastructure" class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover; filter: brightness(0.35);"/>
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(7,59,82,0.85) 0%, rgba(11,79,108,0.7) 100%);"></div>
                    <div class="container py-4 position-relative" style="z-index: 2;">
                        <span class="med-badge-cyan mb-3 text-white" style="background-color: rgba(0,168,150,0.3); border-color: #00A896;">Clinical Infrastructure</span>
                        <h1 class="display-4 fw-bold mb-3 text-white">Advanced Medical Facilities</h1>
                        <div class="med-divider"></div>
                        <p class="lead mx-auto text-light" style="max-width: 700px;">World-class surgical suites, robotic consoles, 24/7 diagnostic labs, and comfort-driven inpatient recovery rooms.</p>
                    </div>
                </section>

                <t t-call="website_hospitality_luxe.s_services_facilities"/>

                <!-- Detailed Facility Showcase -->
                <section class="py-5 bg-white">
                    <div class="container py-4">
                        <div class="row align-items-center g-5 mb-5">
                            <div class="col-lg-6">
                                <div class="position-relative rounded-4 overflow-hidden shadow">
                                    <img src="/website_hospitality_luxe/static/src/img/content/facility_operation_theatre.jpg" alt="Modular Operation Theatres" class="w-100" style="min-height: 360px; object-fit: cover;"/>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <span class="med-badge-navy mb-3">Precision Surgery</span>
                                <h2 class="h2 fw-bold mb-3" style="color: #0B4F6C;">Modular Operation Theatres with HEPA Laminar Flow</h2>
                                <div class="med-divider-left"></div>
                                <p class="text-muted mb-4" style="line-height: 1.8;">
                                    Our 12 state-of-the-art modular operating theatres are engineered to international cleanroom standards with 0.3-micron HEPA filtration, positive pressure control, and integrated laparoscopic imaging towers to ensure near-zero surgical site infection rates.
                                </p>
                                <ul class="list-unstyled text-muted small d-flex flex-column gap-2 mb-4">
                                    <li><i class="fa fa-check-circle text-success me-2"></i> Dedicated Robotic Surgery Suite (Da Vinci Xi)</li>
                                    <li><i class="fa fa-check-circle text-success me-2"></i> Ultra-Clean Vertical Laminar Air Flow (Class 100)</li>
                                    <li><i class="fa fa-check-circle text-success me-2"></i> Real-time Intraoperative Fluoroscopy &amp; C-Arm Imaging</li>
                                </ul>
                            </div>
                        </div>

                        <div class="row align-items-center g-5 flex-lg-row-reverse mb-5">
                            <div class="col-lg-6">
                                <div class="position-relative rounded-4 overflow-hidden shadow">
                                    <img src="/website_hospitality_luxe/static/src/img/content/hospital_private_suite.jpg" alt="Private Patient Suites" class="w-100" style="min-height: 360px; object-fit: cover;"/>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <span class="med-badge-cyan mb-3">Healing Environment</span>
                                <h2 class="h2 fw-bold mb-3" style="color: #0B4F6C;">Private Inpatient Recovery Suites</h2>
                                <div class="med-divider-left"></div>
                                <p class="text-muted mb-4" style="line-height: 1.8;">
                                    Designed to feel like a haven of restorative peace, our private rooms provide ergonomic electric Fowler beds, nurse call buttons, accompanying attendant beds, en-suite bathrooms, and panoramic natural light.
                                </p>
                                <ul class="list-unstyled text-muted small d-flex flex-column gap-2 mb-4">
                                    <li><i class="fa fa-check-circle text-success me-2"></i> 24/7 Dedicated Nursing Care &amp; Bedside Monitoring</li>
                                    <li><i class="fa fa-check-circle text-success me-2"></i> Centralized Medical Oxygen &amp; Vacuum Ports</li>
                                    <li><i class="fa fa-check-circle text-success me-2"></i> Personalized Clinical Dietary Meal Service</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>

                <t t-call="website_hospitality_luxe.s_virtual_tour"/>
                <t t-call="website_hospitality_luxe.s_appointment_bar"/>
                <t t-call="website_hospitality_luxe.s_appointment_cta"/>
            </div>
        </t>
    </template>

    <!-- 5. About Us Page -->
    <template id="about_us" name="About Us - Hospital Care">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Page Hero -->
                <section class="py-5 text-white text-center position-relative" style="background-color: #073B52; min-height: 320px; display: flex; align-items: center;">
                    <img src="/website_hospitality_luxe/static/src/img/content/facility_entrance.jpg" alt="About Hospital" class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover; filter: brightness(0.35);"/>
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(7,59,82,0.85) 0%, rgba(11,79,108,0.7) 100%);"></div>
                    <div class="container py-4 position-relative" style="z-index: 2;">
                        <span class="med-badge-cyan mb-3 text-white" style="background-color: rgba(0,168,150,0.3); border-color: #00A896;">Healing Heritage</span>
                        <h1 class="display-4 fw-bold mb-3 text-white">Healing with Compassion, Leading with Science</h1>
                        <div class="med-divider"></div>
                        <p class="lead mx-auto text-light" style="max-width: 700px;">Over 25 years of tertiary healthcare excellence, patient safety benchmarks, and clinical research innovation.</p>
                    </div>
                </section>

                <!-- Hospital Mission & Values -->
                <section class="py-5 bg-white">
                    <div class="container py-4">
                        <div class="row g-5 align-items-center">
                            <div class="col-lg-6">
                                <span class="med-badge-navy mb-3">Our Mission &amp; Ethics</span>
                                <h2 class="h2 fw-bold mb-3" style="color: #0B4F6C;">A Patient-First Philosophy Driven by Clinical Integrity</h2>
                                <div class="med-divider-left"></div>
                                <p class="text-muted mb-4" style="line-height: 1.8;">
                                    Founded with the foundational vision that every human life deserves exceptional medical care, MediCare Hospital has evolved into an internationally recognized tertiary referral health center.
                                </p>
                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <div class="p-3 rounded-3" style="background: #F4F9F9; border-left: 3px solid #00A896;">
                                            <h5 class="fw-bold mb-1" style="color: #0B4F6C; font-size: 1rem;"><i class="fa fa-heartbeat text-danger me-2"></i>Compassion</h5>
                                            <p class="small text-muted mb-0">Empathy and respect at every point of the patient healing journey.</p>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="p-3 rounded-3" style="background: #F4F9F9; border-left: 3px solid #0B4F6C;">
                                            <h5 class="fw-bold mb-1" style="color: #0B4F6C; font-size: 1rem;"><i class="fa fa-stethoscope text-primary me-2"></i>Excellence</h5>
                                            <p class="small text-muted mb-0">Adherence to strict global evidence-based medical treatment guidelines.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="position-relative rounded-4 overflow-hidden shadow">
                                    <img src="/website_hospitality_luxe/static/src/img/content/facility_waiting_zone.jpg" alt="Hospital Reception" class="w-100" style="min-height: 380px; object-fit: cover;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <t t-call="website_hospitality_luxe.s_hospital_stats"/>
                <t t-call="website_hospitality_luxe.s_accreditation_badges"/>
                <t t-call="website_hospitality_luxe.s_insurance_partners"/>
                <t t-call="website_hospitality_luxe.s_appointment_cta"/>
            </div>
        </t>
    </template>

    <!-- 6. Patient & Visitor Guide Page -->
    <template id="patient_guide" name="Patient Guide - Hospital Care">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
